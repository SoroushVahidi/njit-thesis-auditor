# Binary files — stored in Git LFS
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text
*.rar  filter=lfs diff=lfs merge=lfs -text

# Production-parity inputs must match Git blob bytes on Windows as well as Linux.
/data/processed/rules/project_added_rules.json text eol=lf
/src/njit_auditor/audit_runner.py text eol=lf
/src/njit_auditor/rules/*.py text eol=lf
