# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Build artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local data and generated artifacts
*.log
*.tmp
data/evaluation/generated/
data/evaluation/private/

# Archive files (download locally; do not commit the raw archive bundles)
*.rar

# Temporary extraction directories
/tmp/rar_extract/
/tmp/handouts/

# Web upload runtime (uploaded PDFs and generated reports must never be committed)
.runtime/
var/web_audits/
tests/fixtures/web_demo/demo_project_extracted/

# Script scratch output (dated audit/analysis runs written by scripts/*.py; may
# contain extracted text derived from private evaluation samples — never commit)
/results/

# OS/editor files
.DS_Store
.vscode/
.idea/

# Isolated native desktop build environment
.venv-build/
